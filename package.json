{
	"name": "obsidian-vscode-search",
	"version": "0.2.0",
	"description": "VS Code style find and replace widget for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"search",
		"replace",
		"codemirror"
	],
	"license": "Apache-2.0",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "9.30.1",
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "1.10.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.1"
	},
	"overrides": {
		"moment": "^2.31.0"
	}
}
